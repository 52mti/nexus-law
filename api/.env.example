APP_NAME=nexus-law-api
ENV=development
API_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=*

# Stage 2+
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_law
REDIS_URL=redis://localhost:6379/0

# Stage 3+
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# true 时日志会包含回复预览；生产建议 false
LLM_LOG_CONTENT=false

# Stage 4+
AGENT_MAX_ITERATIONS=6

# Stage 5 notes:
# POST /api/v1/agents/run/stream returns text/event-stream

# Stage 6 — Weaviate (dev & prod)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=NexusLawDocuments
# 若聊天代理无 /embeddings，请单独配置（默认回退到 LLM_*）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
