APP_NAME=nexus-law-api
ENV=development
API_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=*

# Stage 2+
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_law
REDIS_URL=redis://localhost:6379/0

# Stage 3+
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# true 时日志会包含回复预览；生产建议 false
LLM_LOG_CONTENT=false
