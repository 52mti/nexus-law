APP_NAME=nexus-law-api
ENV=development
API_PREFIX=/api/v1
DEBUG=true
CORS_ORIGINS=*

# Stage 2+
# Local dev (host): localhost. Docker Compose overrides to service hostnames.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus_law
REDIS_URL=redis://localhost:6379/0

# Neo4j (docker compose service: neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_law_dev

# Stage 3+
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# true 时日志会包含回复预览；生产建议 false
LLM_LOG_CONTENT=false

# Stage 4+
AGENT_MAX_ITERATIONS=6

# Stage 5 notes:
# POST /api/v1/agents/run/stream returns text/event-stream

# Stage 6 ? Weaviate (dev & prod)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=NexusLawDocuments
# SiliconFlow embeddings (OpenAI-compatible). No local vector model.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# Stage 7 ? hardening
# Comma-separated. Auth auto-enables when non-empty.
API_KEYS=
# AUTH_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
AGENT_TOOL_WHITELIST=get_current_time,calculator,search_documents
PROMPT_GUARD_ENABLED=true

# JWT + Kong gateway (api folder only)
JWT_SECRET=dev-jwt-secret-change-me
JWT_ISSUER_NORMAL=nexus-law-normal
JWT_ISSUER_VIP=nexus-law-vip
JWT_EXPIRE_HOURS=24
# Set true when FastAPI runs behind Kong (docker compose sets this automatically)
TRUST_KONG_HEADERS=false
SKIP_APP_RATE_LIMIT_FOR_GATEWAY=true
# Kong normal-user limit (rendered into kong.yml.template)
KONG_NORMAL_RATE_LIMIT_PER_MINUTE=60

# Tencent COS ? original file archive (wired in parse BackgroundTask when enabled)
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_KEY_PREFIX=documents/
COS_AVATAR_PREFIX=avatars/
